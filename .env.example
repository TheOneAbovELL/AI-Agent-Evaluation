# TraceGrade configuration template.
# Copy to `.env` in the directory you start TraceGrade from, then edit.
# Never commit `.env`; it is listed in .gitignore.
# Every setting is optional: with no `.env` at all TraceGrade runs offline.

# --- Provider credentials (only for the providers you use) -----------------------------
# GROQ_API_KEY=gsk_...
# OPENAI_API_KEY=sk-...

# --- Agent under test ------------------------------------------------------------------
# offline | groq | openai   (offline = deterministic rule-based stand-in, not an LLM)
TRACEGRADE_AGENT_PROVIDER=offline
# Blank = provider default (offline: reference, groq: qwen/qwen3.8-27b, openai: gpt-5.4).
# offline variants: reference | naive
TRACEGRADE_AGENT_MODEL=
# Leave blank to omit the parameter (some reasoning models reject temperature).
TRACEGRADE_AGENT_TEMPERATURE=0.0
TRACEGRADE_AGENT_TIMEOUT_SECONDS=300
# Retries per model call (client + agent middleware): rate limits, timeouts, 5xx,
# and invalid tool calls generated by the model.
TRACEGRADE_AGENT_MAX_RETRIES=4
TRACEGRADE_AGENT_RECURSION_LIMIT=25
# enforced (tools validate eligibility and amounts) | prompt_only (policy only in the prompt)
TRACEGRADE_POLICY_MODE=enforced

# --- LLM-as-a-judge (DeepEval) ---------------------------------------------------------
# none | groq | openai   (none = LLM-judge metrics are reported as skipped)
TRACEGRADE_JUDGE_PROVIDER=none
# Blank = provider default (groq: openai/gpt-oss-120b, openai: gpt-5.4).
TRACEGRADE_JUDGE_MODEL=
TRACEGRADE_JUDGE_TIMEOUT_SECONDS=180
TRACEGRADE_JUDGE_MAX_RETRIES=4

# --- Execution and storage -------------------------------------------------------------
# Free/on-demand Groq tiers have low tokens-per-minute limits: use 1 there.
TRACEGRADE_MAX_CONCURRENCY=2
TRACEGRADE_RUNS_DIR=runs
TRACEGRADE_DATASETS_DIR=datasets
TRACEGRADE_MAX_UPLOAD_BYTES=1000000

# --- Logging ---------------------------------------------------------------------------
# DEBUG | INFO | WARNING | ERROR
TRACEGRADE_LOG_LEVEL=INFO
# text | json
TRACEGRADE_LOG_FORMAT=text
# TRACEGRADE_LOG_FILE=logs/tracegrade.log

# DeepEval telemetry is disabled by TraceGrade unless you set this explicitly.
# DEEPEVAL_TELEMETRY_OPT_OUT=1
